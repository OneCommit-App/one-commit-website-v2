# Public download-link configuration.
# Copy to .env.local for local testing, or set these in the staging/production host.
# Do not put private credentials or other secrets in NEXT_PUBLIC_* variables.
# Leave these empty until a real OneCommit TestFlight, App Store, Play, or owned deep-link URL exists.
# Accepted destinations: TestFlight public join link, App Store app page, Google Play app details page,
# Branch/App Link, OneLink, or an owned app subdomain such as download.onecommit.us.
# Do not paste placeholder external links into this file.

NEXT_PUBLIC_APP_DOWNLOAD_URL=""
NEXT_PUBLIC_IOS_DOWNLOAD_URL=""
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=""
NEXT_PUBLIC_APP_STORE_ID=""
