# Public Supabase browser client configuration.
# Copy to .env.local for local testing, or set these in the staging/production host.
# Do not put service-role keys or other server secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
